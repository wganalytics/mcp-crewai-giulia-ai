# PRJ-07 crewai (text-to-SQL) — copie para .env e preencha.

# --- LLM (multi-provider via LiteLLM/CrewAI) ---
#   OpenAI -> gpt-4o-mini | Anthropic -> anthropic/claude-3-5-sonnet-20240620
#   Gemini -> gemini/gemini-1.5-flash | OpenRouter -> openrouter/openai/gpt-4o-mini
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- PostgreSQL ---
# PG_USER deve ser um role SOMENTE-LEITURA (ver "Segurança" no README).
# Não use 'postgres' fora de um ambiente descartável.
PG_HOST=localhost
PG_PORT=5432
PG_USER=giulia_ro
PG_PASSWORD=

# Nomes dos bancos (não são segredo).
PG_ECOMMERCE_DB=ecommerce
PG_CLINICA_DB=clinica

# Tempo máximo (ms) de uma query gerada pelo LLM antes de ser cancelada.
PG_STATEMENT_TIMEOUT_MS=15000
